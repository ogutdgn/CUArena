{
  "id": "twin/tb-autofit-window",
  "kind": "micro-twin",
  "feature": "Table",
  "signedOff": "generated",
  "ooxmlTask": "tb-autofit-window",
  "note": "AutoFit Window via the dropdown changes the model.",
  "steps": [
    {
      "do": "setupText",
      "text": "Twin base."
    },
    {
      "do": "activateTab",
      "tab": "insert"
    },
    {
      "do": "openDropdown",
      "cmd": "table"
    },
    {
      "do": "gridPick",
      "rows": 3,
      "cols": 3
    },
    {
      "do": "clickCellPainted",
      "index": 0
    },
    {
      "do": "activateTab",
      "tab": "table-layout"
    },
    {
      "do": "openDropdown",
      "cmd": "tblAutoFit"
    },
    {
      "do": "clickItem",
      "match": "AutoFit Window"
    },
    {
      "expect": "docChanged"
    }
  ]
}
