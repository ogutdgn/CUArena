{
  "id": "twin/tb-totext-tab",
  "kind": "micro-twin",
  "feature": "Table",
  "signedOff": "generated",
  "ooxmlTask": "tb-totext-tab",
  "note": "Convert to Text removes the painted table.",
  "steps": [
    {
      "do": "setupText",
      "text": "Twin base."
    },
    {
      "do": "activateTab",
      "tab": "insert"
    },
    {
      "do": "openDropdown",
      "cmd": "table"
    },
    {
      "do": "gridPick",
      "rows": 3,
      "cols": 3
    },
    {
      "do": "caretIntoCellModel",
      "index": 0
    },
    {
      "do": "activateTab",
      "tab": "table-layout"
    },
    {
      "do": "clickCmd",
      "cmd": "tblToText"
    },
    {
      "expect": "paintedCellCount",
      "equals": 0
    }
  ]
}
