# Agent providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=computer-use-preview

# Trace backend selection
# sqlite | s3 | postgres-s3
CUA_TRACE_BACKEND=sqlite

# sqlite backend
CUA_TRACE_DB=cua-eval/runs/trace_store.sqlite3

# s3 backend (artifact-only, no SQL metadata store)
CUA_TRACE_S3_BUCKET=cua-bench-logs
CUA_TRACE_S3_PREFIX=cua-traces
CUA_TRACE_AWS_REGION=us-east-1
# Optional custom endpoint for S3-compatible object stores
CUA_TRACE_S3_ENDPOINT_URL=

# postgres-s3 backend
CUA_TRACE_POSTGRES_DSN=postgresql://user:pass@host:5432/dbname?sslmode=require
